# Supabase — à récupérer dans Project Settings > API sur supabase.com
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentification : gérée par Supabase Auth (pas de clé à fournir ici).
# Le SMTP des emails d'auth (confirmation, code de connexion, mot de passe
# oublié) se configure dans le dashboard Supabase :
# Project Settings > Authentication > SMTP Settings
#   Host : smtp-relay.brevo.com
#   Port : 587
#   User : votre login SMTP Brevo (ex. b80971001@smtp-relay.brevo.com)
#   Pass : votre clé SMTP Brevo complète (pas la valeur tronquée affichée à l'écran)
# Pensez aussi à activer un code à 6 chiffres dans Authentication > Email
# Templates (variable {{ .Token }}) si vous voulez un code plutôt qu'un lien.

# Brevo (https://app.brevo.com/settings/keys/api) — réservé aux futurs emails
# transactionnels applicatifs (confirmation de commande, billet, etc.),
# distinct du SMTP ci-dessus : c'est une clé API (xkeysib-...), pas une clé SMTP.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Paiement (à configurer selon le(s) fournisseur(s) retenu(s))
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# Sous-domaines dynamiques (himra.tikeo.com, §14-16 du cahier des charges).
# Optionnel : par défaut "tikeo.com". À ne changer qu'en production si le
# nom de domaine réel diffère.
# NUXT_PUBLIC_ROOT_DOMAIN=
